{% extends "layouts/dps.html" %}

{% block pageTitle %}
  Page not found
{% endblock %}

{% set mainClasses = "govuk-main-wrapper--l" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Page not found</h1>
      <p class="govuk-body">There is no page at <strong>{{ path }}</strong>.</p>
      <p class="govuk-body">Check that the link is correct, or go back to the previous page.</p>
    </div>
  </div>
{% endblock %}
